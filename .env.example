# Copier vers .env pour le développement local. Aucune valeur secrète réelle ici.

ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://kairos:kairos@localhost:5432/kairos
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
DEFAULT_CURRENCY=EUR
FX_MAX_AGE_HOURS=24
ACTIVE_RULESET_VERSION=1.2.0
CURSOR_SECRET=dev-cursor-secret-not-for-production
DEV_PRINCIPAL_EMAIL=dev@kairos.local
